{
  "name": "jewish-educational-resources",
  "version": "1.0.0",
  "private": true,
  "description": "Biblioteca de recursos educacionais — Vue 3 + Express + MySQL",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "db:setup": "npm run db:setup --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed-aleph-bet": "npm run db:seed-aleph-bet --prefix backend",
    "db:regenerate-pdfs": "npm run db:regenerate-pdfs --prefix backend",
    "db:regenerate-pdfs-gemini": "npm run db:regenerate-pdfs-gemini --prefix backend",
    "db:mariadb": "scripts\\setup-mariadb-wsl.bat",
    "hero:remove-bg": "python scripts/remove-hero-bg.py",
    "build": "npm run build --prefix frontend",
    "verify:release": "node scripts/verify-release.js",
    "test:e2e": "playwright test --config=qa/playwright.config.mjs",
    "test:e2e:headed": "playwright test --config=qa/playwright.config.mjs --headed",
    "start": "concurrently -n backend,frontend -c blue,green \"npm run start --prefix backend\" \"npm run preview --prefix frontend\"",
    "docker:up": "docker compose --env-file .env.docker up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "concurrently": "^9.1.2"
  }
}
